{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tessera — a GPU unit-visualisation engine for the browser, in the spirit of Microsoft Live Labs Pivot",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench-headless.mjs",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "test:e2e": "node scripts/tour-e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.65.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
}
